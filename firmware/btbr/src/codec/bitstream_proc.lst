 424:src/codec/bitstream_proc.c **** /* Unfec23 
 425:src/codec/bitstream_proc.c ****  * out: out buffer of BYTE_ALIGNED(nbits)
 426:src/codec/bitstream_proc.c ****  * in : input buffer of nbits * 15/10
 427:src/codec/bitstream_proc.c ****  * out_of: output offset in bits
 428:src/codec/bitstream_proc.c ****  * nbits: size of output in bits
 429:src/codec/bitstream_proc.c **** */
 430:src/codec/bitstream_proc.c **** /* libbtbb:
 431:src/codec/bitstream_proc.c ****  * comments are the bit that's wrong and the value
 432:src/codec/bitstream_proc.c ****  * of diff in air order, from BT spec vol 2, part G, 9: FEC sample data */
 433:src/codec/bitstream_proc.c **** static const uint16_t fec23_cor[32] = {
 434:src/codec/bitstream_proc.c **** 	[0x0b] = 0x01,
 435:src/codec/bitstream_proc.c **** 	[0x16] = 0x02,
 436:src/codec/bitstream_proc.c **** 	[0x07] = 0x04,
 437:src/codec/bitstream_proc.c **** 	[0x0e] = 0x08,
 438:src/codec/bitstream_proc.c **** 	[0x1c] = 0x10,
 439:src/codec/bitstream_proc.c **** 	[0x13] = 0x20,
 440:src/codec/bitstream_proc.c **** 	[0x0d] = 0x40,
 441:src/codec/bitstream_proc.c **** 	[0x1a] = 0x80,
 442:src/codec/bitstream_proc.c **** 	[0x1f] = 0x100,
 443:src/codec/bitstream_proc.c **** 	[0x15] = 0x200
 444:src/codec/bitstream_proc.c **** };
 445:src/codec/bitstream_proc.c **** 
 446:src/codec/bitstream_proc.c **** static inline uint16_t unfec23_10bits(uint16_t in)
ARM GAS  /tmp/ccPtvV2c.s 			page 24


 447:src/codec/bitstream_proc.c **** {
 448:src/codec/bitstream_proc.c **** 	uint16_t data, err, cor;
 449:src/codec/bitstream_proc.c **** 
 450:src/codec/bitstream_proc.c **** 	data = in & 0x3ff;
 451:src/codec/bitstream_proc.c **** 	err = 0x1f & ((in>>10)^fec23_tbl[data]);
 452:src/codec/bitstream_proc.c **** 	cor = fec23_cor[err];
 453:src/codec/bitstream_proc.c **** 	data ^= cor;
 454:src/codec/bitstream_proc.c **** 	/* FIXME: handle ber */
 455:src/codec/bitstream_proc.c **** 	return data;
 456:src/codec/bitstream_proc.c **** }
