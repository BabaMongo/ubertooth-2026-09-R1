 142:include/ubtbr/bb.h **** static inline uint8_t hec_compute(uint16_t data, uint8_t hec) 
 143:include/ubtbr/bb.h **** {
 144:include/ubtbr/bb.h **** 	extern const uint8_t hec_tbl[32];
 145:include/ubtbr/bb.h **** 
