  65:src/btphy/hop.c **** static uint8_t hop_selection_kernel(uint8_t x, uint8_t y1, uint8_t y2,
  66:src/btphy/hop.c **** 			uint8_t a, uint8_t b, uint8_t c,
  67:src/btphy/hop.c **** 			uint16_t d, uint8_t e, uint8_t f)
  68:src/btphy/hop.c **** {
  69:src/btphy/hop.c **** 	/* Extend y1 on 5 bits */
