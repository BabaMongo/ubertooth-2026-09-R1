 142:src/btphy/rf.c **** static void spi_delay() {
 143:src/btphy/rf.c **** 	volatile int delay_counter;
 144:src/btphy/rf.c **** 	delay_counter = 10;
 145:src/btphy/rf.c **** 	while (--delay_counter);
