 105:src/util/tinyprintf.c **** static void lli2a(long long int num, struct param *p)
 106:src/util/tinyprintf.c **** {
 107:src/util/tinyprintf.c ****     if (num < 0) {
 108:src/util/tinyprintf.c ****         num = -num;
 109:src/util/tinyprintf.c ****         p->sign = '-';
 110:src/util/tinyprintf.c ****     }
 111:src/util/tinyprintf.c ****     ulli2a(num, p);
 112:src/util/tinyprintf.c **** }
