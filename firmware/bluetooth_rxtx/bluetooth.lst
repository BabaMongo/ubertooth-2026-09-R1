  90:bluetooth.c   **** /* 5 bit permutation */
  91:bluetooth.c   **** static u8 perm5(u8 z, u8 p_high, u16 p_low)
  92:bluetooth.c   **** {
  93:bluetooth.c   **** 	/* z is constrained to 5 bits, p_high to 5 bits, p_low to 9 bits */
  94:bluetooth.c   **** 	z &= 0x1f;
  95:bluetooth.c   **** 	p_high &= 0x1f;
  96:bluetooth.c   **** 	p_low &= 0x1ff;
  97:bluetooth.c   **** 
  98:bluetooth.c   **** 	int i;
  99:bluetooth.c   **** 	u8 tmp, output, z_bit[5], p[14];
 100:bluetooth.c   **** 	static const u8 index1[] = {0, 2, 1, 3, 0, 1, 0, 3, 1, 0, 2, 1, 0, 1};
 101:bluetooth.c   **** 	static const u8 index2[] = {1, 3, 2, 4, 4, 3, 2, 4, 4, 3, 4, 3, 3, 2};
 102:bluetooth.c   **** 
 103:bluetooth.c   **** 	/* bits of p_low and p_high are control signals */
 104:bluetooth.c   **** 	for (i = 0; i < 9; i++)
 105:bluetooth.c   **** 		p[i] = (p_low >> i) & 0x01;
 106:bluetooth.c   **** 	for (i = 0; i < 5; i++)
 107:bluetooth.c   **** 		p[i+9] = (p_high >> i) & 0x01;
 108:bluetooth.c   **** 
 109:bluetooth.c   **** 	/* bit swapping will be easier with an array of bits */
 110:bluetooth.c   **** 	for (i = 0; i < 5; i++)
 111:bluetooth.c   **** 		z_bit[i] = (z >> i) & 0x01;
 112:bluetooth.c   **** 
 113:bluetooth.c   **** 	/* butterfly operations */
 114:bluetooth.c   **** 	for (i = 13; i >= 0; i--) {
ARM GAS  /tmp/ccvWlUMR.s 			page 9


 115:bluetooth.c   **** 		/* swap bits according to index arrays if control signal tells us to */
 116:bluetooth.c   **** 		if (p[i]) {
 117:bluetooth.c   **** 			tmp = z_bit[index1[i]];
 118:bluetooth.c   **** 			z_bit[index1[i]] = z_bit[index2[i]];
 119:bluetooth.c   **** 			z_bit[index2[i]] = tmp;
 120:bluetooth.c   **** 		}
 121:bluetooth.c   **** 	}
 122:bluetooth.c   **** 
 123:bluetooth.c   **** 	/* reconstruct output from rearranged bits */
 124:bluetooth.c   **** 	output = 0;
 125:bluetooth.c   **** 	for (i = 0; i < 5; i++)
 126:bluetooth.c   **** 		output += z_bit[i] << i;
 127:bluetooth.c   **** 
 128:bluetooth.c   **** 	return output;
 129:bluetooth.c   **** }
