  37:bluetooth.c   **** /* count the number of 1 bits in a uint64_t */
  38:bluetooth.c   **** static uint8_t count_bits(uint64_t n)
  39:bluetooth.c   **** {
  40:bluetooth.c   **** 	uint8_t i = 0;
  41:bluetooth.c   **** 	for (i = 0; n != 0; i++)
  42:bluetooth.c   **** 		n &= n - 1;
  43:bluetooth.c   **** 	return i;
  44:bluetooth.c   **** }
