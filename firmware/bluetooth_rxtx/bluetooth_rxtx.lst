 787:bluetooth_rxtx.c **** 					clk100ns_offset = 1;
 788:bluetooth_rxtx.c **** 				}
 789:bluetooth_rxtx.c **** 
 790:bluetooth_rxtx.c **** 				// Too slow
 791:bluetooth_rxtx.c **** 				else {
