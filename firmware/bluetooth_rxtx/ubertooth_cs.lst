  38:ubertooth_cs.c **** #define CS_THRESHOLD_DEFAULT (int8_t)(-120)
  39:ubertooth_cs.c **** 
  40:ubertooth_cs.c **** 
  41:ubertooth_cs.c **** /* Set CC2400 carrier sense threshold and store value to
  42:ubertooth_cs.c ****  * global. CC2400 RSSI is determined by 54dBm + level. CS threshold is
  43:ubertooth_cs.c ****  * in 4dBm steps, so the provided level is rounded to the nearest
  44:ubertooth_cs.c ****  * multiple of 4 by adding 56. Useful range is -100 to -20. */
  45:ubertooth_cs.c **** static void cs_threshold_set(int8_t level, cs_samples_t samples)
  46:ubertooth_cs.c **** {
  47:ubertooth_cs.c **** 	level = level < -120 ? -120 : level;
  48:ubertooth_cs.c **** 	level = level > -20 ? -20 : level;
  49:ubertooth_cs.c **** 	cc2400_set(RSSI, (uint8_t)((level + 56) & (0x3f << 2)) | ((uint8_t)samples&3));
  50:ubertooth_cs.c **** 	cs_threshold_cur = level;
  51:ubertooth_cs.c **** 	cs_no_squelch = (level <= -120);
  52:ubertooth_cs.c **** }
  53:ubertooth_cs.c **** 
