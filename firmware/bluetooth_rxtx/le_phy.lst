 916:le_phy.c      **** static int filter_match(le_rx_t *buf) {
 917:le_phy.c      **** 	if (!le.target_set)
 918:le_phy.c      **** 		return 1;
 919:le_phy.c      **** 
 920:le_phy.c      **** 	// allow all data channel packets
 921:le_phy.c      **** 	if (btle_channel_index(buf->channel) < 37)
 922:le_phy.c      **** 		return 1;
 923:le_phy.c      **** 
 924:le_phy.c      **** 	switch (buf->data[0] & 0xf) {
 925:le_phy.c      **** 		// ADV_IND, ADV_NONCONN_IND, ADV_SCAN_IND, SCAN_RSP
 926:le_phy.c      **** 		case 0x00:
 927:le_phy.c      **** 		case 0x02:
 928:le_phy.c      **** 		case 0x06:
 929:le_phy.c      **** 		case 0x04:
 930:le_phy.c      **** 			// header + one address
 931:le_phy.c      **** 			if (buf->size < 2 + 6)
 932:le_phy.c      **** 				return 0;
 933:le_phy.c      **** 			return bd_addr_cmp(&buf->data[2]);
 934:le_phy.c      **** 			break;
 935:le_phy.c      **** 
 936:le_phy.c      **** 		// ADV_DIRECT_IND, SCAN_REQ, CONNECT_REQ
 937:le_phy.c      **** 		case 0x01:
 938:le_phy.c      **** 		case 0x03:
 939:le_phy.c      **** 		case 0x05:
ARM GAS  /tmp/cc7dqibQ.s 			page 56


 940:le_phy.c      **** 			// header + two addresses
 941:le_phy.c      **** 			if (buf->size < 2 + 6 + 6)
 942:le_phy.c      **** 				return 0;
 943:le_phy.c      **** 			return bd_addr_cmp(&buf->data[2]) ||
 944:le_phy.c      **** 				   bd_addr_cmp(&buf->data[8]);
 945:le_phy.c      **** 			break;
 946:le_phy.c      **** 
 947:le_phy.c      **** 		default:
 948:le_phy.c      **** 			break;
 949:le_phy.c      **** 	}
 950:le_phy.c      **** 
 951:le_phy.c      **** 	return 0;
 952:le_phy.c      **** }
