 894:le_phy.c      **** 						connection_update_handler(buf);
 895:le_phy.c      **** 					break;
 896:le_phy.c      **** 
 897:le_phy.c      **** 				// LE_CHANNEL_MAP_REQ -- update channel map
 898:le_phy.c      **** 				case 0x1:
