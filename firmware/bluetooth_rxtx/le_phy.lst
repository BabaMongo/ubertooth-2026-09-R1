 163:le_phy.c      **** // resets the state of all available buffers
 164:le_phy.c      **** static void buffers_init(void) {
 165:le_phy.c      **** 	int i;
 166:le_phy.c      **** 
 167:le_phy.c      **** 	for (i = 0; i < LE_BUFFER_POOL_SIZE; ++i)
 168:le_phy.c      **** 		le_buffer_pool[i].available = 1;
 169:le_phy.c      **** }
 170:le_phy.c      **** 
 171:le_phy.c      **** // clear a buffer for new data
 172:le_phy.c      **** static void buffer_clear(le_rx_t *buf) {
 173:le_phy.c      **** 	buf->pos = 0;
 174:le_phy.c      **** 	buf->size = 0;
 175:le_phy.c      **** 	memset(buf->data, 0, sizeof(buf->data));
 176:le_phy.c      **** 	buf->rssi_min = INT8_MAX;
 177:le_phy.c      **** 	buf->rssi_max = INT8_MIN;
 178:le_phy.c      **** 	buf->rssi_sum = 0;
 179:le_phy.c      **** }
 180:le_phy.c      **** 
 181:le_phy.c      **** // get a packet buffer
 182:le_phy.c      **** // returns a pointer to a buffer if available
 183:le_phy.c      **** // returns NULL otherwise
 184:le_phy.c      **** static le_rx_t *buffer_get(void) {
 185:le_phy.c      **** 	int i;
 186:le_phy.c      **** 
 187:le_phy.c      **** 	for (i = 0; i < LE_BUFFER_POOL_SIZE; ++i) {
 188:le_phy.c      **** 		if (le_buffer_pool[i].available) {
 189:le_phy.c      **** 			le_buffer_pool[i].available = 0;
 190:le_phy.c      **** 			buffer_clear(&le_buffer_pool[i]);
 191:le_phy.c      **** 			return &le_buffer_pool[i];
 192:le_phy.c      **** 		}
 193:le_phy.c      **** 	}
 194:le_phy.c      **** 
 195:le_phy.c      **** 	return NULL;
 196:le_phy.c      **** }
 197:le_phy.c      **** 
 198:le_phy.c      **** // release a buffer back to the pool
 199:le_phy.c      **** static void buffer_release(le_rx_t *buffer) {
 200:le_phy.c      **** 	buffer->available = 1;
 201:le_phy.c      **** }
 202:le_phy.c      **** 
 203:le_phy.c      **** // clear a connection event
 204:le_phy.c      **** static void reset_conn_event(void) {
ARM GAS  /tmp/cc7dqibQ.s 			page 5


 205:le_phy.c      **** 	conn_event.num_packets = 0;
 206:le_phy.c      **** 	conn_event.opened = 0;
 207:le_phy.c      **** }
 208:le_phy.c      **** 
 209:le_phy.c      **** // finish a connection event
 210:le_phy.c      **** //
 211:le_phy.c      **** // 1) update the anchor point (see details below)
 212:le_phy.c      **** // 2) increment connection event counter
 213:le_phy.c      **** // 3) check if supervision timeout is exceeded
 214:le_phy.c      **** // 4) setup radio for next packet (data or adv if timeout exceeded)
 215:le_phy.c      **** //
 216:le_phy.c      **** // anchor update logic can be summarized thusly:
 217:le_phy.c      **** // 1) if we received two packets, set the connection anchor to the
 218:le_phy.c      **** //    observed value
 219:le_phy.c      **** // 2) if we received one packet, see if it's within ANCHOR_EPISLON
 220:le_phy.c      **** //    microseconds if the expected anchor time. if so, it's the master
 221:le_phy.c      **** //    and we can update the anchor
 222:le_phy.c      **** // 3) if the single packet is a slave or we received zero packets,
 223:le_phy.c      **** //    update the anchor to the estimated value
 224:le_phy.c      **** //
 225:le_phy.c      **** // FIXME this code does not properly handle the case where the initial
 226:le_phy.c      **** // connection transmit window has no received packets
 227:le_phy.c      **** static void finish_conn_event(void) {
 228:le_phy.c      **** 	uint32_t last_anchor = 0;
 229:le_phy.c      **** 	int last_anchor_set = 0;
 230:le_phy.c      **** 
 231:le_phy.c      **** 	// two packets -- update anchor
 232:le_phy.c      **** 	if (conn_event.num_packets == 2) {
 233:le_phy.c      **** 		last_anchor = conn_event.anchor;
 234:le_phy.c      **** 		last_anchor_set = 1;
 235:le_phy.c      **** 	}
 236:le_phy.c      **** 
 237:le_phy.c      **** 	// if there's one packet, we need to find out if it was the master
 238:le_phy.c      **** 	else if (conn_event.num_packets == 1 && conn.anchor_set) {
 239:le_phy.c      **** 		// calculate the difference between the estimated and observed anchor
 240:le_phy.c      **** 		uint32_t estimated_anchor = conn.last_anchor + conn.conn_interval;
 241:le_phy.c      **** 		uint32_t delta = estimated_anchor - conn_event.anchor;
 242:le_phy.c      **** 		// see whether the observed anchor is within 3 us of the estimate
 243:le_phy.c      **** 		delta += ANCHOR_EPSILON;
 244:le_phy.c      **** 		if (delta < 2 * ANCHOR_EPSILON) {
 245:le_phy.c      **** 			last_anchor = conn_event.anchor;
 246:le_phy.c      **** 			last_anchor_set = 1;
 247:le_phy.c      **** 		}
 248:le_phy.c      **** 	}
 249:le_phy.c      **** 
 250:le_phy.c      **** 	// if we observed a new anchor, set it
 251:le_phy.c      **** 	if (last_anchor_set) {
 252:le_phy.c      **** 		conn.last_anchor = last_anchor;
 253:le_phy.c      **** 		conn.anchor_set = 1;
 254:le_phy.c      **** 	}
 255:le_phy.c      **** 
 256:le_phy.c      **** 	// without a new anchor, estimate the next anchor
 257:le_phy.c      **** 	else if (conn.anchor_set) {
 258:le_phy.c      **** 		conn.last_anchor += conn.conn_interval;
 259:le_phy.c      **** 	}
 260:le_phy.c      **** 
 261:le_phy.c      **** 	else {
ARM GAS  /tmp/cc7dqibQ.s 			page 6


 262:le_phy.c      **** 		// FIXME this is totally broken if we receive the slave's packet first
 263:le_phy.c      **** 		conn.last_anchor = conn_event.anchor;
 264:le_phy.c      **** 		conn.last_packet_ts = NOW; // FIXME gross hack
 265:le_phy.c      **** 	}
 266:le_phy.c      **** 
 267:le_phy.c      **** 	// update last packet for supervision timeout
 268:le_phy.c      **** 	if (conn_event.num_packets > 0) {
 269:le_phy.c      **** 		conn.last_packet_ts = NOW;
 270:le_phy.c      **** 	}
 271:le_phy.c      **** 
 272:le_phy.c      **** 	reset_conn_event();
 273:le_phy.c      **** 
 274:le_phy.c      **** 	// increment connection event counter
 275:le_phy.c      **** 	++conn.conn_event_counter;
 276:le_phy.c      **** 
 277:le_phy.c      **** 	// supervision timeout reached - switch back to advertising
 278:le_phy.c      **** 	if (NOW - conn.last_packet_ts > conn.supervision_timeout) {
 279:le_phy.c      **** 		reset_conn();
 280:le_phy.c      **** 		change_channel();
 281:le_phy.c      **** 	}
 282:le_phy.c      **** 
 283:le_phy.c      **** 	// FIXME - hack to cancel following a connection
 284:le_phy.c      **** 	else if (cancel_follow) {
 285:le_phy.c      **** 		cancel_follow = 0;
 286:le_phy.c      **** 		reset_conn();
 287:le_phy.c      **** 		change_channel();
 288:le_phy.c      **** 	}
 289:le_phy.c      **** 
 290:le_phy.c      **** 	// supervision timeout not reached - hop to next channel
 291:le_phy.c      **** 	else {
 292:le_phy.c      **** 		timer1_set_match(conn.last_anchor + conn.conn_interval - RX_WARMUP_TIME);
 293:le_phy.c      **** 	}
 294:le_phy.c      **** }
 295:le_phy.c      **** 
 296:le_phy.c      **** // DMA handler
 297:le_phy.c      **** // called once per byte. handles all incoming data, but only minimally
 298:le_phy.c      **** // processes received data. at the end of a packet, it enqueues the
 299:le_phy.c      **** // received packet, fetches a new buffer, and restarts RX.
 300:le_phy.c      **** void le_DMA_IRQHandler(void) {
 301:le_phy.c      **** 	unsigned pos;
 302:le_phy.c      **** 	int8_t rssi;
 303:le_phy.c      **** 	uint32_t timestamp = NOW; // sampled early for most accurate measurement
 304:le_phy.c      **** 
 305:le_phy.c      **** 	// channel 0
 306:le_phy.c      **** 	if (DMACIntStat & (1 << 0)) {
 307:le_phy.c      **** 		// terminal count - byte received
 308:le_phy.c      **** 		if (DMACIntTCStat & (1 << 0)) {
 309:le_phy.c      **** 			DMACIntTCClear = (1 << 0);
 310:le_phy.c      **** 
 311:le_phy.c      **** 			// poll RSSI
 312:le_phy.c      **** 			rssi = (int8_t)(cc2400_get(RSSI) >> 8);
 313:le_phy.c      **** 			current_rxbuf->rssi_sum += rssi;
 314:le_phy.c      **** 			if (rssi < current_rxbuf->rssi_min) current_rxbuf->rssi_min = rssi;
 315:le_phy.c      **** 			if (rssi > current_rxbuf->rssi_max) current_rxbuf->rssi_max = rssi;
 316:le_phy.c      **** 
 317:le_phy.c      **** 			// grab byte from DMA buffer
 318:le_phy.c      **** 			pos = current_rxbuf->pos;
ARM GAS  /tmp/cc7dqibQ.s 			page 7


 319:le_phy.c      **** 			current_rxbuf->data[pos] = le_dma_dest[pos & 1]; // dirty hack
 320:le_phy.c      **** 			pos += 1;
 321:le_phy.c      **** 			current_rxbuf->pos = pos;
 322:le_phy.c      **** 
 323:le_phy.c      **** 			if (pos == 1) {
 324:le_phy.c      **** 				current_rxbuf->timestamp = timestamp - USEC(8 + 32); // packet starts at preamble
 325:le_phy.c      **** 				current_rxbuf->channel = rf_channel;
 326:le_phy.c      **** 				current_rxbuf->access_address = conn.access_address;
 327:le_phy.c      **** 
 328:le_phy.c      **** 				// data packet received: cancel timeout
 329:le_phy.c      **** 				// new timeout or hop timer will be set at end of packet RX
 330:le_phy.c      **** 				if (btle_channel_index(rf_channel) < 37) {
 331:le_phy.c      **** 					timer1_clear_match();
 332:le_phy.c      **** 				}
 333:le_phy.c      **** 			}
 334:le_phy.c      **** 
 335:le_phy.c      **** 			// get length from header
 336:le_phy.c      **** 			if (pos == 2) {
 337:le_phy.c      **** 				uint8_t length = dewhiten_length(current_rxbuf->channel, current_rxbuf->data[1]);
 338:le_phy.c      **** 				current_rxbuf->size = length + 2 + 3; // two bytes for header and three for CRC
 339:le_phy.c      **** 			}
 340:le_phy.c      **** 
 341:le_phy.c      **** 			// finished packet - state transition
 342:le_phy.c      **** 			if (pos > 2 && pos >= current_rxbuf->size) {
 343:le_phy.c      **** 				// stop the CC2400 before flushing SSP
 344:le_phy.c      **** 				cc2400_strobe(SFSON);
 345:le_phy.c      **** 
 346:le_phy.c      **** 				// stop DMA on this channel and flush SSP
 347:le_phy.c      **** 				DMACC0Config = 0;
 348:le_phy.c      **** 				DMACIntTCClear = (1 << 0); // if we don't clear a second time, data is corrupt
 349:le_phy.c      **** 
 350:le_phy.c      **** 				DIO_SSP_DMACR &= ~SSPDMACR_RXDMAE;
 351:le_phy.c      **** 				while (SSP1SR & SSPSR_RNE) {
 352:le_phy.c      **** 					uint8_t tmp = (uint8_t)DIO_SSP_DR;
 353:le_phy.c      **** 				}
 354:le_phy.c      **** 
 355:le_phy.c      **** 				// XXX disable DMA interrupt as a workaround
 356:le_phy.c      **** 				ICER0 = ICER0_ICE_DMA;
 357:le_phy.c      **** 
 358:le_phy.c      **** 				// TODO error transition on queue_insert
 359:le_phy.c      **** 				queue_insert(&packet_queue, current_rxbuf);
 360:le_phy.c      **** 
 361:le_phy.c      **** 				// track connection events
 362:le_phy.c      **** 				if (btle_channel_index(rf_channel) < 37) {
 363:le_phy.c      **** 					++conn_event.num_packets;
 364:le_phy.c      **** 
 365:le_phy.c      **** 					// first packet: set connection anchor
 366:le_phy.c      **** 					if (conn_event.num_packets == 1) {
 367:le_phy.c      **** 						conn_event.anchor = current_rxbuf->timestamp;
 368:le_phy.c      **** 						timer1_set_match(NOW + IFS_TIMEOUT); // set a timeout for next packet
 369:le_phy.c      **** 					}
 370:le_phy.c      **** 
 371:le_phy.c      **** 					// second packet: close connection event, and set hop timer
 372:le_phy.c      **** 					else if (conn_event.num_packets == 2) {
