 438:le_phy.c      **** // initalize USB, SSP, and DMA
 439:le_phy.c      **** static void le_sys_init(void) {
 440:le_phy.c      **** 	usb_queue_init(); // USB FIFO FIXME replace with safer queue
 441:le_phy.c      **** 	dio_ssp_init();   // init SSP and raise !CS (self-routed GPIO)
