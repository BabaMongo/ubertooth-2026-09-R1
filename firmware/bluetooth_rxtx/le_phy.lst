 723:le_phy.c      **** // helper function to dewhiten length from whitened data (only used
 724:le_phy.c      **** // during DMA)
 725:le_phy.c      **** static uint8_t dewhiten_length(unsigned channel, uint8_t data) {
 726:le_phy.c      **** 	unsigned int i, bit;
 727:le_phy.c      **** 	int idx = whitening_index[btle_channel_index(channel)];
 728:le_phy.c      **** 	uint8_t out = 0;
 729:le_phy.c      **** 
 730:le_phy.c      **** 	// length is second byte of packet
 731:le_phy.c      **** 	idx = (idx + 8) % sizeof(whitening);
 732:le_phy.c      **** 
 733:le_phy.c      **** 	for (i = 0; i < 8; ++i) {
 734:le_phy.c      **** 		bit = (data >> (7-i)) & 1;
 735:le_phy.c      **** 		bit ^= whitening[idx];
 736:le_phy.c      **** 		idx = (idx + 1) % sizeof(whitening);
 737:le_phy.c      **** 		out |= bit << i;
 738:le_phy.c      **** 	}
 739:le_phy.c      **** 
 740:le_phy.c      **** 	return out;
 741:le_phy.c      **** }
