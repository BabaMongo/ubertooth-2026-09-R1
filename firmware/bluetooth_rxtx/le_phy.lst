 443:le_phy.c      **** 	dio_ssp_start();  // enable SSP + DMA
 444:le_phy.c      **** }
 445:le_phy.c      **** 
 446:le_phy.c      **** // initialize RF and strobe FSON
 447:le_phy.c      **** static void le_cc2400_init_rf(void) {
 448:le_phy.c      **** 	u16 grmdm, mdmctrl;
 449:le_phy.c      **** 	uint32_t sync = rbit(conn.access_address);
 450:le_phy.c      **** 
ARM GAS  /tmp/cc7dqibQ.s 			page 11


 451:le_phy.c      **** 	mdmctrl = 0x0040; // 250 kHz frequency deviation
 452:le_phy.c      **** 	grmdm = 0x44E1; // un-buffered mode, packet w/ sync word detection
 453:le_phy.c      **** 	// 0 10 00 1 001 11 0 00 0 1
 454:le_phy.c      **** 	//   |  |  | |   |  +--------> CRC off
 455:le_phy.c      **** 	//   |  |  | |   +-----------> sync word: 32 MSB bits of SYNC_WORD
 456:le_phy.c      **** 	//   |  |  | +---------------> 1 preamble byte of 01010101
 457:le_phy.c      **** 	//   |  |  +-----------------> packet mode
 458:le_phy.c      **** 	//   |  +--------------------> un-buffered mode
 459:le_phy.c      **** 	//   +-----------------------> sync error bits: 2
 460:le_phy.c      **** 
 461:le_phy.c      **** 	cc2400_set(MANAND,  0x7ffe);
 462:le_phy.c      **** 	cc2400_set(LMTST,   0x2b22);
 463:le_phy.c      **** 
 464:le_phy.c      **** 	cc2400_set(MDMTST0, 0x124b);
 465:le_phy.c      **** 	// 1      2      4b
 466:le_phy.c      **** 	// 00 0 1 0 0 10 01001011
 467:le_phy.c      **** 	//    | | | | |  +---------> AFC_DELTA = ??
 468:le_phy.c      **** 	//    | | | | +------------> AFC settling = 4 pairs (8 bit preamble)
 469:le_phy.c      **** 	//    | | | +--------------> no AFC adjust on packet
 470:le_phy.c      **** 	//    | | +----------------> do not invert data
 471:le_phy.c      **** 	//    | +------------------> TX IF freq 1 0Hz
 472:le_phy.c      **** 	//    +--------------------> PRNG off
 473:le_phy.c      **** 	//
 474:le_phy.c      **** 	// ref: CC2400 datasheet page 67
 475:le_phy.c      **** 	// AFC settling explained page 41/42
 476:le_phy.c      **** 
 477:le_phy.c      **** 	cc2400_set(GRMDM,   grmdm);
 478:le_phy.c      **** 
 479:le_phy.c      **** 	cc2400_set(SYNCL,   sync & 0xffff);
 480:le_phy.c      **** 	cc2400_set(SYNCH,   (sync >> 16) & 0xffff);
 481:le_phy.c      **** 
 482:le_phy.c      **** 	cc2400_set(FSDIV,   rf_channel - 1); // 1 MHz IF
 483:le_phy.c      **** 	cc2400_set(MDMCTRL, mdmctrl);
 484:le_phy.c      **** 
 485:le_phy.c      **** 	// XOSC16M should always be stable, but leave this test anyway
 486:le_phy.c      **** 	while (!(cc2400_status() & XOSC16M_STABLE));
 487:le_phy.c      **** 
 488:le_phy.c      **** 	// wait for FS_LOCK in background
 489:le_phy.c      **** 	cc2400_strobe(SFSON);
 490:le_phy.c      **** 	timer1_wait_fs_lock();
 491:le_phy.c      **** }
 492:le_phy.c      **** 
 493:le_phy.c      **** // strobe RX and enable PA
 494:le_phy.c      **** static void le_cc2400_strobe_rx(void) {
 495:le_phy.c      **** 	cc2400_strobe(SRX);
 496:le_phy.c      **** #ifdef UBERTOOTH_ONE
 497:le_phy.c      **** 	PAEN_SET;
 498:le_phy.c      **** 	HGM_SET;
 499:le_phy.c      **** #endif
 500:le_phy.c      **** }
 501:le_phy.c      **** 
 502:le_phy.c      **** // change channel and init rx
 503:le_phy.c      **** static void change_channel(void) {
 504:le_phy.c      **** 	uint8_t channel_idx = 0;
 505:le_phy.c      **** 
 506:le_phy.c      **** 	cc2400_strobe(SRFOFF);
 507:le_phy.c      **** 
ARM GAS  /tmp/cc7dqibQ.s 			page 12


 508:le_phy.c      **** 	// stop DMA and flush SSP
 509:le_phy.c      **** 	DIO_SSP_DMACR &= ~SSPDMACR_RXDMAE;
 510:le_phy.c      **** 	while (SSP1SR & SSPSR_RNE) {
 511:le_phy.c      **** 		uint8_t tmp = (uint8_t)DIO_SSP_DR;
 512:le_phy.c      **** 	}
 513:le_phy.c      **** 
 514:le_phy.c      **** 	buffer_clear(current_rxbuf);
 515:le_phy.c      **** 	le_dma_init();
 516:le_phy.c      **** 	dio_ssp_start();
 517:le_phy.c      **** 
 518:le_phy.c      **** 	if (conn.access_address == ADVERTISING_AA) {
 519:le_phy.c      **** 		// FIXME
 520:le_phy.c      **** 		switch (le_adv_channel) {
 521:le_phy.c      **** 			case 2402: channel_idx = 37; break;
 522:le_phy.c      **** 			case 2426: channel_idx = 38; break;
 523:le_phy.c      **** 			case 2480: channel_idx = 39; break;
 524:le_phy.c      **** 			default:   channel_idx = 37; break;
 525:le_phy.c      **** 		}
 526:le_phy.c      **** 	} else {
 527:le_phy.c      **** 		conn.channel_idx = (conn.channel_idx + conn.hop_increment) % 37;
 528:le_phy.c      **** 		channel_idx = le_map_channel(conn.channel_idx, &conn.remapping);
 529:le_phy.c      **** 	}
 530:le_phy.c      **** 
 531:le_phy.c      **** 	rf_channel = btle_channel_index_to_phys(channel_idx);
 532:le_phy.c      **** 	le_cc2400_init_rf();
 533:le_phy.c      **** }
