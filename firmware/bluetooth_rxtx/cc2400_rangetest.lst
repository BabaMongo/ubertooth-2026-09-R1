  22:cc2400_rangetest.c **** #include "cc2400_rangetest.h"
  23:cc2400_rangetest.c **** 
  24:cc2400_rangetest.c **** rangetest_result rr;
  25:cc2400_rangetest.c **** 
  26:cc2400_rangetest.c **** /*
  27:cc2400_rangetest.c ****  * This range test transmits a Bluetooth-like (but not Bluetooth compatible)
  28:cc2400_rangetest.c ****  * packet to a repeater and then receives the repeated packet.  It is only
  29:cc2400_rangetest.c ****  * useful if another device is running cc2400_repeater() some distance away.
  30:cc2400_rangetest.c ****  *
  31:cc2400_rangetest.c ****  * The outgoing packet is transmitted at each power amplifier (PA) level from
ARM GAS  /tmp/ccJwY5dk.s 			page 2


  32:cc2400_rangetest.c ****  * lowest to highest.  It is sent several times at each level.  The repeater
  33:cc2400_rangetest.c ****  * takes the first packet to be received correctly and repeats it in a similar
  34:cc2400_rangetest.c ****  * manner.  The result should indicate the lowest successful PA level in each
  35:cc2400_rangetest.c ****  * direction.
  36:cc2400_rangetest.c ****  *
  37:cc2400_rangetest.c ****  * The range test packet consists of:
  38:cc2400_rangetest.c ****  *   preamble: 4 bytes
  39:cc2400_rangetest.c ****  *   sync word: 4 bytes
  40:cc2400_rangetest.c ****  *   payload:
  41:cc2400_rangetest.c ****  *     length: 1 byte (21)
  42:cc2400_rangetest.c ****  *     packet type: 1 byte (0 = request; 1 = reply)
  43:cc2400_rangetest.c ****  *     LPC17xx serial number: 16 bytes
  44:cc2400_rangetest.c ****  *     request pa: 1 byte
  45:cc2400_rangetest.c ****  *     request number: 1 byte
  46:cc2400_rangetest.c ****  *     reply pa: 1 byte
  47:cc2400_rangetest.c ****  *     reply number: 1 byte
  48:cc2400_rangetest.c ****  *   crc: 2 bytes
  49:cc2400_rangetest.c ****  */
  50:cc2400_rangetest.c **** 
  51:cc2400_rangetest.c **** #ifdef TX_ENABLE
